# Safe local examples only. Do not commit a real .env file.
DOTNET_ENVIRONMENT=Development

FOREXALERT_ForexAlert__CurrencyPairs__0=EUR/USD
FOREXALERT_ForexAlert__CurrencyPairs__1=GBP/USD
FOREXALERT_ForexAlert__CurrencyPairs__2=USD/JPY
FOREXALERT_ForexAlert__CurrencyPairs__3=USD/CAD
FOREXALERT_ForexAlert__DailyThresholdPercent=1.4
FOREXALERT_ForexAlert__SleepWindowNegativeThresholdPercent=-2.4
FOREXALERT_ForexAlert__HourlyThresholdPercent=1.4
FOREXALERT_ForexAlert__WeeklyThresholdPercent=5
FOREXALERT_ForexAlert__OneMinuteEnabled=false
FOREXALERT_ForexAlert__OneMinuteThresholdPercent=1.4
FOREXALERT_ForexAlert__DailyBaseline=PreviousClose
FOREXALERT_ForexAlert__Cooldown=1.00:00:00
FOREXALERT_ForexAlert__EvaluationInterval=00:01:00
FOREXALERT_ForexAlert__MarketTimeZone=America/New_York
FOREXALERT_ForexAlert__FridayCloseTime=17:00:00
FOREXALERT_ForexAlert__SundayOpenTime=17:00:00
FOREXALERT_ForexAlert__TradingDayOpenTime=00:00:00
FOREXALERT_ForexAlert__SleepWindowStart=23:30:00
FOREXALERT_ForexAlert__SleepWindowEnd=05:00:00
FOREXALERT_ForexAlert__MaxCandlesPerInterval=2000
FOREXALERT_ForexAlert__CooldownStatePath=data/cooldowns.json

FOREXALERT_Notification__Provider=LocalFile
FOREXALERT_Notification__LocalFilePath=data/alerts.txt

FOREXALERT_Ibkr__Host=127.0.0.1
FOREXALERT_Ibkr__PaperTrading=true
FOREXALERT_Ibkr__PaperPort=4002
FOREXALERT_Ibkr__LivePort=4001
FOREXALERT_Ibkr__ClientId=0
FOREXALERT_Ibkr__ConnectionTimeout=00:00:10
FOREXALERT_Ibkr__DisconnectTimeout=00:00:10
FOREXALERT_Ibkr__InitialDataTimeout=00:00:30
FOREXALERT_Ibkr__MaxRetryAttempts=5
FOREXALERT_Ibkr__InitialRetryDelay=00:00:01
FOREXALERT_Ibkr__MaximumRetryDelay=00:00:30
FOREXALERT_Ibkr__QuoteStaleAfter=00:00:15
FOREXALERT_Ibkr__MaximumBidAskSkew=00:00:02
FOREXALERT_Ibkr__HistoricalRequestSpacing=00:00:00.250
FOREXALERT_Ibkr__DailyHistoryRefreshInterval=00:30:00

# Fill these only when Notification__Provider=Twilio. Never commit secrets or phone numbers.
FOREXALERT_Twilio__AccountSid=
FOREXALERT_Twilio__AuthToken=
FOREXALERT_Twilio__FromNumber=
FOREXALERT_Twilio__Recipients__0=
FOREXALERT_Twilio__RequestTimeout=00:00:30
FOREXALERT_Twilio__SuccessfulRecipientCacheDuration=1.00:00:00
FOREXALERT_Twilio__SuccessfulRecipientCacheCapacity=10000
