# ForexAlert reads environment variables through .NET configuration.
# Use double underscores for nested keys. Do not commit a real .env file.
DOTNET_ENVIRONMENT=Development
FOREXALERT_Notifications__Provider=DryRun
FOREXALERT_Notifications__DryRun=true
FOREXALERT_Ibkr__Host=127.0.0.1
FOREXALERT_Ibkr__PaperTrading=true
FOREXALERT_Ibkr__PaperPort=4002
FOREXALERT_Ibkr__ClientId=0

# Required only when Notifications__Provider=Twilio and DryRun=false:
FOREXALERT_Twilio__AccountSid=replace-with-user-secret
FOREXALERT_Twilio__AuthToken=replace-with-user-secret
FOREXALERT_Twilio__FromNumber=+15555550100
FOREXALERT_Twilio__Recipients__0=+15555550101
